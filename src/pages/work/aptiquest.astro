---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { withBase } from "../../lib/paths";

import "../../styles/global.css";
---

<BaseLayout title="AptiQuest | Kumaran">
    <Nav />

    <main class="container mx-auto px-6">
        <a href={withBase("/work")} class="text-sage-600 font-bold tracking-tight inline-block mb-16 hover:gap-2 transition-all">
            ← Back to Projects
        </a>

        <!-- Hero -->
        <header class="flex flex-col-reverse md:flex-row items-start justify-between gap-16 mb-32">
            <div class="md:w-1/2 space-y-8 reveal-up">
                <span class="text-xs font-bold uppercase tracking-widest text-sage-400">Project 01</span>
                <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-sage-900 leading-tight">
                    AptiQuest
                </h1>
                <p class="text-xl text-sage-600 leading-relaxed max-w-xl">
                    An interactive, game-based educational website for college students that makes learning engaging and competitive through real-time challenges and rewards.
                </p>
            </div>
            <div class="md:w-1/2 reveal-up reveal-up-delay-2">
                <div class="relative bg-sage-100 aspect-[4/3] rounded-[2rem] overflow-hidden shadow-2xl border border-sage-100 float">
                    <img src={withBase("/projects/attitude-learning.webp")} alt="AptiQuest" class="w-full h-full object-cover" />
                </div>
            </div>
        </header>

        <!-- Overview -->
        <section class="mb-32 reveal-up">
            <h2 class="text-4xl md:text-6xl font-bold tracking-tighter text-sage-900 mb-8">Overview</h2>
            <p class="text-lg text-sage-600 leading-relaxed max-w-2xl mb-8">
                College life is demanding, and traditional learning tools often feel static and disconnected from student interests. This platform transforms education into an engaging game where students earn points, unlock achievements, and compete on leaderboards while mastering course material.
            </p>
            <p class="text-lg text-sage-600 leading-relaxed max-w-2xl mb-8">
                Built with a React frontend and Node.js backend using MongoDB for persistence and Socket.io for real-time communication, the platform delivers instant feedback and social interaction across all devices.
            </p>
        </section>

        <!-- Problem & Solution -->
        <section class="grid md:grid-cols-2 gap-16 mb-32 reveal-up">
            <div class="space-y-6">
                <span class="text-xs font-bold uppercase tracking-widest text-sage-400">Problem</span>
                <h3 class="text-3xl font-bold text-sage-900 mb-4 tracking-tight">Students lose interest quickly</h3>
                <p class="text-sage-600 leading-relaxed">
                    Traditional e-learning platforms fail to sustain student engagement. Without competition or tangible rewards, course completion rates drop significantly after the first few weeks.
                </p>
            </div>
            <div class="space-y-6">
                <span class="text-xs font-bold uppercase tracking-widest text-sage-400">Solution</span>
                <h3 class="text-3xl font-bold text-sage-900 mb-4 tracking-tight">Game-based learning mechanics</h3>
                <p class="text-sage-600 leading-relaxed">
                    We introduced points, badges, leaderboards, and timed challenges that turn routine study sessions into competitive, rewarding experiences. Real-time multiplayer challenges keep students coming back daily.
                </p>
            </div>
        </section>

        <!-- Features -->
        <section class="mb-32 reveal-up">
            <div class="flex justify-between items-end mb-8">
                <h3 class="text-2xl font-bold text-sage-900 tracking-tight">Confirmed Features</h3>
                <span class="text-xs font-bold uppercase tracking-widest text-sage-400">Technical details</span>
            </div>
            <ul class="grid md:grid-cols-2 gap-6 space-y-6 max-w-3xl">
                <li class="flex items-start gap-4 p-4 bg-white border border-sage-100 rounded-xl shadow-sm group hover:border-sage-300 transition-colors">
                    <div class="flex h-8 w-8 items-center justify-center bg-sage-50 text-sage-500 rounded-lg mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-sage-900 mb-1">Real-time Multiplayer</h4>
                        <p class="text-sage-500 text-sm">Socket.io powered live challenges between students.</p>
                    </div>
                </li>
                <li class="flex items-start gap-4 p-4 bg-white border border-sage-100 rounded-xl shadow-sm group hover:border-sage-300 transition-colors">
                    <div class="flex h-8 w-8 items-center justify-center bg-sage-50 text-sage-500 rounded-lg mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-sage-900 mb-1">Achievement System</h4>
                        <p class="text-sage-500 text-sm">Points, badges, and unlockable milestones for progress.</p>
                    </div>
                </li>
                <li class="flex items-start gap-4 p-4 bg-white border border-sage-100 rounded-xl shadow-sm group hover:border-sage-300 transition-colors">
                    <div class="flex h-8 w-8 items-center justify-center bg-sage-50 text-sage-500 rounded-lg mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="4"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="4"></line></svg>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-sage-900 mb-1">Leaderboards</h4>
                        <p class="text-sage-500 text-sm">Global and course-specific competitive rankings.</p>
                    </div>
                </li>
                <li class="flex items-start gap-4 p-4 bg-white border border-sage-100 rounded-xl shadow-sm group hover:border-sage-300 transition-colors">
                    <div class="flex h-8 w-8 items-center justify-center bg-sage-50 text-sage-500 rounded-lg mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
                    </div>
                    <div>
                        <h4 class="text-lg font-bold text-sage-900 mb-1">Mobile Responsive</h4>
                        <p class="text-sage-500 text-sm">Full experience across desktop and mobile devices.</p>
                    </div>
                </li>
            </ul>
        </section>

        <!-- Tech Stack -->
        <section class="mb-32 reveal-up reveal-up-delay-2">
            <h3 class="text-2xl font-bold text-sage-900 mb-8 tracking-tight">Technology Stack</h3>
            <div class="flex flex-wrap gap-4">
                {["React", "Node.js", "MongoDB", "Socket.io", "Tailwind CSS"].map((tech) => (
                    <span class="px-4 py-2 bg-white border border-sage-200 rounded-lg text-sage-700 font-bold text-sm tracking-tight shadow-sm hover:border-sage-400 hover:bg-sage-50 transition-all cursor-default">
                        {tech}
                    </span>
                ))}
            </div>
        </section>

        <!-- Links -->
        <section class="flex gap-6 reveal-up reveal-up-delay-4">
            <a href="#" class="btn-primary px-8 py-4 text-lg flex-1 text-center">Live Demo (Placeholder)</a>
            <a href="#" class="btn-secondary px-8 py-4 text-lg flex-1 text-center">View Source (Placeholder)</a>
        </section>
    </main>

    <Footer />
</BaseLayout>
