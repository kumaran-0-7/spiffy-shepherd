---
const { title = "Send a project note" } = Astro.props;
---

<div class="contact-form-panel max-w-3xl mx-auto mt-16 rounded-[2rem] border border-sage-200 bg-white p-6 text-left shadow-sm sm:p-10">
    <div class="mb-8">
        <h4 class="text-2xl font-bold tracking-tight text-sage-900">{title}</h4>
        <p class="mt-2 text-sm leading-relaxed text-sage-600">This form opens your email app with a draft. You can review it before sending.</p>
    </div>

    <form
        class="contact-form space-y-5"
        data-contact-form
        action="mailto:kumarangullu4@gmail.com"
        method="post"
        enctype="text/plain"
    >
        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label for="contact-name" class="mb-2 block text-sm font-semibold text-sage-800">Your name</label>
                <input
                    id="contact-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    placeholder="Name"
                    required
                    maxlength="80"
                    class="w-full rounded-xl border border-sage-200 bg-sage-50/60 px-4 py-3 text-sage-900 placeholder:text-sage-400"
                />
            </div>
            <div>
                <label for="contact-email" class="mb-2 block text-sm font-semibold text-sage-800">Your email</label>
                <input
                    id="contact-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    placeholder="you@example.com"
                    required
                    maxlength="160"
                    class="w-full rounded-xl border border-sage-200 bg-sage-50/60 px-4 py-3 text-sage-900 placeholder:text-sage-400"
                />
            </div>
        </div>

        <div>
            <label for="contact-message" class="mb-2 block text-sm font-semibold text-sage-800">What would you like to build?</label>
            <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                maxlength="2500"
                placeholder="A few details about your idea..."
                class="w-full resize-y rounded-xl border border-sage-200 bg-sage-50/60 px-4 py-3 text-sage-900 placeholder:text-sage-400"
            ></textarea>
        </div>

        <button type="submit" class="btn-primary min-h-12 w-full gap-3 sm:w-auto">
            Prepare email draft <span aria-hidden="true">↗</span>
        </button>
        <p class="min-h-6 text-sm text-sage-600" role="status" aria-live="polite" data-contact-status></p>
    </form>
</div>

<script>
    const contactForm = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const contactStatus = contactForm?.querySelector<HTMLElement>("[data-contact-status]");

    contactForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!contactForm.reportValidity()) return;

        const fields = new FormData(contactForm);
        const name = String(fields.get("name") ?? "").trim();
        const email = String(fields.get("email") ?? "").trim();
        const message = String(fields.get("message") ?? "").trim();
        const subject = encodeURIComponent("Portfolio enquiry from " + name);
        const body = encodeURIComponent("Name: " + name + "\nReply to: " + email + "\n\n" + message);

        if (contactStatus) {
            contactStatus.textContent = "Your email app should open with this draft. Review it there and press Send.";
        }

        window.location.href = "mailto:kumarangullu4@gmail.com?subject=" + subject + "&body=" + body;
    });
</script>
